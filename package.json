{
  "name": "die-geheime-ermittlungszentrale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokales Geographie-Detektivspiel für Klasse 7",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check:start": "node scripts/check-start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "materials": "node scripts/materials.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "media:credits": "node scripts/media-credits.mjs",
    "dictionary:report": "node scripts/dictionary-report.mjs",
    "test:pdf": "python3 scripts/check-pdf.py"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
